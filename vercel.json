{
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.swinglify.online"
        }
      ],
      "destination": "https://swinglify.online/:path",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/market-wrap",
      "schedule": "45 10 * * 1-5"
    }
  ]
}
